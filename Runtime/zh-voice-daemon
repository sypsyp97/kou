#!/usr/bin/env python3
"""Resident Qwen3-ASR server.

Loading Qwen3-ASR-1.7B costs ~0.8-1.2 s, which the one-shot CLI paid on every
hotkey press. This keeps the model in RAM and answers over a unix socket:
measured 1.83 s -> 1.06 s on a 3.5 s clip.

Protocol, plain text, one request per connection:
  ->  <wav path>\n<context terms>\n
  <-  <transcript>\n        (or  ERROR: ...\n)
  ->  PING\n\n
  <-  PONG <model>\n        health probe, does not touch the model

Two processes (see worker_main): the model lives in a disposable child process.
This parent process handles only the socket and the timeouts. Exits after ZH_VOICE_IDLE seconds idle so it does not hold ~3.4 GB forever;
exits 70 when the worker misses its deadline, so launchd brings up a fresh one.

The shebang is `env python3` on purpose: any Python can syntax-check the source
and the tests can run it with the system Python. The installer replaces the
first line with the exact interpreter of the uv tool.
"""
import atexit
from contextlib import contextmanager
import fcntl
import multiprocessing
import os
import signal
import socket
import sys
import tempfile
import threading
import time
from types import MethodType
import wave

# Do not touch the network at run time. The models are provisioned at install
# time. Pin offline mode so that HF cannot stretch one transcription into tens
# of seconds of timeout retries on a bad network, which the budget below would
# judge as a hang.
os.environ.setdefault("HF_HUB_OFFLINE", "1")

SOCK_PATH = os.path.expanduser(os.environ.get(
    "ZH_VOICE_SOCKET", "~/.cache/zh-voice/asr.sock"))
MODEL = os.environ.get("ZH_VOICE_MODEL", "mlx-community/Qwen3-ASR-1.7B-8bit")
# The directory that is actually loaded at run time. The installer renders the
# pinned snapshot path into the plist. A repo id alone does NOT pin a version:
# in offline mode huggingface_hub reads refs/main, which is the most recently
# fetched snapshot in the cache, not the pinned ASR_REVISION. After an upstream
# update the two differ, the install pre-check still passes (it only checks that
# the directory exists), and the daemon silently runs other weights. The only
# symptom is worse transcription, which is hard to diagnose.
MODEL_PATH = os.environ.get("ZH_VOICE_MODEL_PATH", "")
IDLE_SEC = float(os.environ.get("ZH_VOICE_IDLE", "3600"))

# Request read limit. The accept loop is single-threaded, so a half-open client
# that sends nothing would block all others. The client (nc) writes both lines
# right after the handshake, so the normal path needs well under a millisecond.
READ_TIMEOUT_SEC = 2.0
# A client that never sends a newline would grow buf without limit. A normal request is one path and one term-list line, so 64 KiB is enough.
MAX_REQUEST_BYTES = 64 * 1024
# Bound retained KV storage for unusually long context strings.
MAX_PREFIX_TOKENS = 1024

# A cold worker start reads 3.4 GB of weights. Allow enough time; beyond this the worker cannot start.
WORKER_START_TIMEOUT_SEC = float(os.environ.get("ZH_VOICE_START_TIMEOUT", "180"))

# Wall-clock budget for one transcription = BASE + FACTOR x audio seconds,
# clamped to [FLOOR, CEIL]. Measured: 3.5 s of audio takes 1.06 s when warm.
# FACTOR=4 leaves a fourfold margin for a heavily loaded machine. Waiting longer
# is better than judging a finished utterance as hung. A fixed timeout does not
# fit: the recording limit is 120 s, and a value that suits short utterances
# would kill long ones routinely.
# CEIL works the other way. During a hang the client falls back to the one-shot
# CLI, which loads another 3.4 GB. Two copies in memory are worse than waiting
# a little longer, so the longest wait is 3 minutes.
HANG_BASE = float(os.environ.get("ZH_VOICE_HANG_BASE", "10"))
HANG_FACTOR = float(os.environ.get("ZH_VOICE_HANG_FACTOR", "4"))
HANG_FLOOR = float(os.environ.get("ZH_VOICE_HANG_FLOOR", "25"))
HANG_CEIL = float(os.environ.get("ZH_VOICE_HANG_CEIL", "180"))

last_used = time.time()
_worker = None
_server = None
_health_server = None
_loaded_from = ""        # the path the worker reports it loaded from; PONG echoes it
_tokenizer_pinned = False   # does the tokenizer also come from that snapshot (see pin_tokenizer_dir)


def model_target():
    """Return the value to pass to load_model. Its parameter is path_or_hf_repo:
    use a local directory (with config.json) directly. Otherwise fall back to the
    repo id and let huggingface_hub follow refs/main.

    The fallback is deliberate: if the pinned path is missing, transcribing with
    the cached version is better than stopping the pipeline. The fallback is not
    invisible: the install check compares the rev= field in PONG with the pinned
    revision."""
    if MODEL_PATH and os.path.isfile(os.path.join(MODEL_PATH, "config.json")):
        return MODEL_PATH
    return MODEL


def pin_tokenizer_dir(target):
    """Make the tokenizer load from target, not from the upstream
    DEFAULT_MODEL_ID repo (transcribe() uses the latter when it gets an already
    loaded model object). Take the module handle from sys.modules:
    `import mlx_qwen3_asr.transcribe as T` returns the re-exported FUNCTION, and
    setting an attribute on it silently has no effect.
    Return False if the pin is not possible; the install pre-check covers that."""
    for name in ("vocab.json", "merges.txt", "tokenizer_config.json"):
        if not os.path.isfile(os.path.join(target, name)):
            return False        # not a local snapshot with its own tokenizer files: nothing to pin
    module = sys.modules.get("mlx_qwen3_asr.transcribe")
    if module is None or not hasattr(module, "DEFAULT_MODEL_ID"):
        return False
    module.DEFAULT_MODEL_ID = target
    return True


def revision_label():
    """The rev= field in PONG: the name of the snapshot directory that was loaded,
    which is the HF commit hash. Report "unpinned" if the revision is not pinned."""
    if _loaded_from and _loaded_from != MODEL:
        return os.path.basename(os.path.normpath(_loaded_from))
    return "unpinned"


def hang_budget(wav):
    """Return how long this audio may take to transcribe. If the duration cannot
    be read (missing file, not a wav), return FLOOR: that request fails in the
    worker at once, so the budget does not matter.

    Compute it in the parent, not in the worker: the side that computes the
    budget must be the side that cannot hang."""
    try:
        with wave.open(wav, "rb") as w:
            dur = w.getnframes() / float(w.getframerate() or 16000)
    except Exception:
        dur = 0.0
    return max(HANG_FLOOR, min(HANG_CEIL, HANG_BASE + HANG_FACTOR * dur))


def watchdog():
    """Release the ~3.4 GB after IDLE_SEC of quiet.

    The poll has to be fine-grained relative to the timeout, not a fixed 30 s:
    with a coarse sleep a small ZH_VOICE_IDLE is simply unreachable, because the
    first check does not even happen until long after it has expired.

    Never called when IDLE_SEC <= 0 (see main): that is the resident mode, and
    with a non-positive timeout the poll would degenerate to a 0.05 s spin that
    exits on the very first tick.
    """
    poll = max(0.05, min(5.0, IDLE_SEC / 20.0))
    while True:
        time.sleep(poll)
        if time.time() - last_used > IDLE_SEC:
            cleanup()          # os._exit skips atexit, so unlink the socket here
            os._exit(0)


def warm_up(model, q):
    """MLX materialises weights lazily, so the first real request would otherwise
    pay for it. Burn that cost here on a scrap of silence instead.

    Scratch file goes under $TMPDIR with a unique name: a fixed /tmp path is
    shared with every other user and with the daemon that is already running, so
    two starts race on the same bytes.
    """
    fd, path = tempfile.mkstemp(prefix="zh-voice-warmup-", suffix=".wav")
    os.close(fd)
    try:
        with wave.open(path, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(16000)
            w.writeframes(b"\x00" * 16000)
        try:
            q.transcribe(path, model=model, language="Chinese")
        except Exception:
            pass
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


class FixedPrefixPrefill:
    """Reuse immutable text-prefix KV within one serial inference worker."""

    def __init__(self, model, tokenizer, context):
        import mlx.core as mx

        self.mx = mx
        self.model = model
        self.original_prefill = None
        self.active = False
        self.hits = 0
        self.fallbacks = 0
        self.cached = None
        self.build_ms = 0.0
        self.prefix_tokens = 0
        self.prefix_ids = []
        prefill = model.prefill
        if not isinstance(prefill, MethodType) or prefill.__self__ is not model:
            return
        self.original_prefill = prefill.__func__
        prompt = tokenizer.build_prompt_tokens(
            n_audio_tokens=1, language="Chinese", context=context,
        )
        if tokenizer.AUDIO_TOKEN_ID not in prompt:
            return
        self.prefix_tokens = prompt.index(tokenizer.AUDIO_TOKEN_ID)
        self.prefix_ids = prompt[:self.prefix_tokens]
        if not 0 < self.prefix_tokens <= MAX_PREFIX_TOKENS:
            return

        mx.synchronize()
        started = time.perf_counter()
        positions = mx.arange(self.prefix_tokens)[None, :]
        self.prefix_positions = mx.stack([positions, positions, positions], axis=1)
        self.position_values = self.prefix_positions.tolist()
        self.cached = model.create_cache(max_seq_len=self.prefix_tokens)
        model.model(
            input_ids=mx.array([self.prefix_ids]),
            position_ids=self.prefix_positions,
            cache=self.cached,
        )
        mx.eval(self.cached.keys, self.cached.values)
        mx.synchronize()
        self.build_ms = (time.perf_counter() - started) * 1000

    def prefill(self, instance, input_ids, audio_features, position_ids, cache):
        mx = self.mx
        length = self.prefix_tokens
        compatible = (
            self.cached is not None
            and instance is self.model
            and input_ids.ndim == 2
            and input_ids.shape[0] == 1
            and input_ids.shape[1] > length
            and position_ids.shape == (1, 3, input_ids.shape[1])
            and position_ids.dtype == self.prefix_positions.dtype
            and cache.offset == 0
            and cache.max_seq_len is not None
            and cache.max_seq_len >= input_ids.shape[1]
        )
        if compatible:
            compatible = (
                input_ids[0, :length].tolist() == self.prefix_ids
                and position_ids[:, :, :length].tolist() == self.position_values
            )
        if not compatible:
            self.fallbacks += 1
            return self.original_prefill(
                instance, input_ids=input_ids, audio_features=audio_features,
                position_ids=position_ids, cache=cache,
            )

        # Keep the request's capacity. A prefix-only fork cannot append tokens.
        for index, (key, value) in enumerate(
            zip(self.cached.keys, self.cached.values, strict=True)
        ):
            if key is None or value is None:
                raise RuntimeError("Fixed-prefix cache has an unpopulated layer")
            key_buffer = mx.zeros(
                (key.shape[0], key.shape[1], cache.max_seq_len, key.shape[3]),
                dtype=key.dtype,
            )
            value_buffer = mx.zeros(
                (value.shape[0], value.shape[1], cache.max_seq_len, value.shape[3]),
                dtype=value.dtype,
            )
            key_buffer[..., :length, :] = key
            value_buffer[..., :length, :] = value
            cache.keys[index] = key_buffer
            cache.values[index] = value_buffer
        cache.offset = length
        self.hits += 1
        return self.original_prefill(
            instance,
            input_ids=input_ids[:, length:],
            audio_features=audio_features,
            position_ids=position_ids[:, :, length:],
            cache=cache,
        )

    @contextmanager
    def enabled(self):
        if self.cached is None:
            yield self
            return
        if self.active:
            raise RuntimeError("Fixed-prefix cache contexts cannot nest")
        model_type = type(self.model)
        if model_type.prefill is not self.original_prefill:
            raise RuntimeError("Model prefill changed before cache activation")

        def replacement(instance, *args, **kwargs):
            return self.prefill(instance, *args, **kwargs)

        self.active = True
        model_type.prefill = replacement
        try:
            yield self
        finally:
            model_type.prefill = self.original_prefill
            self.active = False


def worker_main(pipe):
    """Keep MLX in a disposable child process.

    This is the most important design decision in this file. A Metal call can
    hang without killing Python. If inference ran in the socket process, there
    would be two bad options: launchd sees a healthy PID and never restarts it,
    or a watchdog thread calls os._exit, and whether that thread gets scheduled
    depends on whether the hung C call releases the GIL. Do not rely on that.

    The parent never imports mlx and never touches Metal, so it can always
    answer. It sets a deadline for the request. At the deadline it replies ERROR,
    so the client falls back to the one-shot CLI at once (the user still gets
    text), and then it exits. launchd starts a fresh worker. Process death is the
    only way to discard a broken Metal context.

    Import MLX inside the function body: spawn re-imports this file, and a
    module-level import would make the parent pay the load as well.
    """
    try:
        import mlx.core as mx
        import mlx_qwen3_asr as q
        from mlx_qwen3_asr.tokenizer import _TokenizerHolder

        target = model_target()
        # Must run before any transcribe call, including warm_up below, which also calls transcribe.
        tokenizer_pinned = pin_tokenizer_dir(target)
        model, _ = q.load_model(target)
        # Keep the weights in physical RAM; without this macOS can page them out
        # during idle stretches and the next utterance pays to fault them back in.
        try:
            mx.set_wired_limit(
                mx.device_info()["max_recommended_working_set_size"])
        except Exception:
            pass
        warm_up(model, q)
        tokenizer = _TokenizerHolder.get(target)
        cached_context = None
        prefix_cache = None

        def transcribe(wav, context):
            nonlocal cached_context, prefix_cache
            if not context:
                return q.transcribe(wav, model=model, context=context,
                                    language="Chinese")
            if context != cached_context:
                prefix_cache = FixedPrefixPrefill(model, tokenizer, context)
                cached_context = context
                print("prefix-cache tokens=%d cached=%s" % (
                    prefix_cache.prefix_tokens, prefix_cache.cached is not None,
                ), flush=True)
            with prefix_cache.enabled():
                return q.transcribe(wav, model=model, context=context,
                                    language="Chinese")

        # Report what the model was loaded from, not MODEL. The parent uses it to
        # tell the outside which revision runs and whether the tokenizer is pinned
        # (the install check uses the tok= field in PONG as a go-live gate).
        pipe.send(("READY", {"model": target, "tokenizer_pinned": tokenizer_pinned}))
    except Exception as exc:
        try:
            pipe.send(("START_ERROR", f"{type(exc).__name__}: {exc}"))
        except Exception:
            pass
        return

    while True:
        try:
            message = pipe.recv()
        except (EOFError, OSError):
            return
        if not message or message[0] == "STOP":
            return
        _, wav, context = message
        try:
            result = transcribe(wav, context)
            reply = " ".join(str(result.text).splitlines()).strip()
            # The term bias can suppress the whole output: a full term-list line is
            # a strong prior and a short utterance may produce nothing. An empty
            # result means the user spoke for nothing, so ask once more without
            # the context. This costs one extra run only on a path that would
            # otherwise return nothing.
            if not reply and context:
                print("空转写，去掉术语偏置重试一次", flush=True)
                result = transcribe(wav, "")
                reply = " ".join(str(result.text).splitlines()).strip()
            pipe.send(("RESULT", reply))
        except Exception as exc:
            pipe.send(("ERROR", f"{type(exc).__name__}: {exc}"))


class WorkerTimeout(RuntimeError):
    """The worker did not reply by the deadline. Treat it as hung; the parent then exits."""


class WorkerUnavailable(RuntimeError):
    """The worker is gone or cannot start. Replace it as well."""


class ASRWorker:
    def __init__(self):
        self.pipe = None
        self.proc = None
        self.deadline = None

    def start(self):
        ctx = multiprocessing.get_context("spawn")
        parent, child = ctx.Pipe()
        proc = ctx.Process(target=worker_main, args=(child,),
                           name="zh-voice-asr-worker", daemon=True)
        proc.start()
        child.close()               # if the parent kept this end, recv would never see EOF
        self.pipe, self.proc = parent, proc
        if not parent.poll(WORKER_START_TIMEOUT_SEC):
            self.stop()
            raise WorkerUnavailable(
                f"模型 worker 在 {WORKER_START_TIMEOUT_SEC:g}s 内没能就绪")
        try:
            kind, payload = parent.recv()
        except (EOFError, OSError) as exc:
            self.stop()
            raise WorkerUnavailable(f"模型 worker 启动过程中退出了：{exc}")
        if kind != "READY":
            self.stop()
            raise WorkerUnavailable(payload)
        return payload

    def alive(self):
        return bool(self.proc and self.proc.is_alive())

    def transcribe(self, wav, context):
        if not self.alive():
            raise WorkerUnavailable("模型 worker 不在跑")
        budget = hang_budget(wav)
        self.deadline = time.monotonic() + budget
        try:
            self.pipe.send(("TRANSCRIBE", wav, context))
        except (BrokenPipeError, EOFError, OSError) as exc:
            raise WorkerUnavailable(f"请求送不进模型 worker：{exc}")
        if not self.pipe.poll(budget):
            raise WorkerTimeout(f"转写卡死：{wav} 超过 {budget:.0f}s 预算未返回")
        try:
            kind, payload = self.pipe.recv()
        except (EOFError, OSError) as exc:
            raise WorkerUnavailable(f"模型 worker 中途退出：{exc}")
        if kind == "RESULT":
            self.deadline = None
            return payload
        # Transcription error caught by the worker (for example an unreadable wav): fail this request only and keep the worker.
        self.deadline = None
        raise RuntimeError(payload)

    def stop(self):
        pipe, self.pipe = self.pipe, None
        proc, self.proc = self.proc, None
        if pipe is not None:
            try:
                pipe.send(("STOP",))
            except Exception:
                pass
            try:
                pipe.close()
            except Exception:
                pass
        if proc is not None and proc.is_alive():
            # A hung worker ignores both STOP and SIGTERM, so SIGKILL is required:
            # it is the step that discards the broken Metal context.
            proc.terminate()
            proc.join(timeout=3)
            if proc.is_alive():
                proc.kill()
                proc.join(timeout=3)


def handle(conn, worker, health_only=False):
    """Serve one request. Nothing in here may propagate: this runs on the accept
    loop's own thread, so an escaping exception takes the resident server down.

    Return True if this daemon is no longer trustworthy. The caller then exits so
    that launchd starts a new one."""
    restart = False
    try:
        try:
            conn.settimeout(READ_TIMEOUT_SEC)
            buf = b""
            while buf.count(b"\n") < 2:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                buf += chunk
                if len(buf) > MAX_REQUEST_BYTES:
                    raise ValueError("请求超过 64 KiB")
            lines = buf.decode("utf-8").split("\n")
            wav = lines[0].strip()
            context = (lines[1] if len(lines) > 1 else "").strip()
            if wav == "PING":
                # Health probe. It does not touch the model on purpose: it tests
                # whether the accept loop runs and the worker is alive. During a
                # hang the parent can still answer, but it exits at the timeout,
                # so the outside sees a refused connection and not a false healthy
                # state. The reply carries the model name so the install check can
                # confirm which model runs.
                if not worker.alive():
                    raise WorkerUnavailable("模型 worker 不在跑")
                deadline = worker.deadline
                if deadline is not None and time.monotonic() > deadline:
                    raise WorkerTimeout("worker deadline exceeded")
                reply = (f"PONG {MODEL} rev={revision_label()}"
                         f" tok={'pinned' if _tokenizer_pinned else 'upstream'}"
                         f" state={'busy' if deadline is not None else 'idle'}")
            elif health_only:
                raise ValueError("health socket accepts PING only")
            elif not wav:
                raise ValueError("请求里没有 wav 路径")
            else:
                started = time.monotonic()
                reply = worker.transcribe(wav, context)
                # Report the transcription time (only on transcription replies; PING
                # and ERROR stay unchanged). Client-side timing would include nc and
                # the socket. The transcript is guaranteed to be one line, so after
                # the header line the contract "the last line is the transcript"
                # still holds.
                elapsed_ms = int((time.monotonic() - started) * 1000)
                reply = "META asr_ms=%d\n%s" % (elapsed_ms, reply)
        except (WorkerTimeout, WorkerUnavailable) as exc:
            # Send ERROR to the client before exiting. zh-voice falls back to the
            # one-shot CLI at once on ERROR, so the user still gets text. If the
            # daemon just died, the client would wait for the full nc timeout.
            reply = f"ERROR: daemon 不健康：{exc}；正在重启"
            restart = True
            print(reply, flush=True)
        except Exception as exc:           # one bad request must not kill the server
            reply = f"ERROR: {type(exc).__name__}: {exc}"
        # The reply write also needs the try. If the client hangs up before it
        # reads (Ctrl-C, timeout), sendall raises BrokenPipeError, which would
        # propagate to main() and take the resident model down.
        conn.sendall((reply + "\n").encode("utf-8"))
    except Exception:
        pass
    finally:
        try:
            conn.close()
        except OSError:
            pass
    return restart


def cleanup():
    """A stale socket file makes the client think the daemon is alive and cost it
    a failed connect before falling back."""
    global _worker, _server, _health_server
    # Take the object out first, then clear the global: atexit and the idle watchdog each call cleanup, so it must be re-entrant.
    worker, _worker = _worker, None
    if worker is not None:
        worker.stop()
    server, _server = _server, None
    if server is not None:
        try:
            server.close()
        except OSError:
            pass
    try:
        os.unlink(SOCK_PATH)
    except OSError:
        pass
    health_server, _health_server = _health_server, None
    if health_server is not None:
        health_server.close()
    try:
        os.unlink(SOCK_PATH + ".health")
    except OSError:
        pass


def main():
    cache_dir = os.path.dirname(SOCK_PATH)
    # Modes 700/600: only the current user may reach the socket and the lock. A
    # socket with mode srwxr-xr-x would let any account on the machine send
    # requests and read transcripts. Restricting it costs nothing.
    os.makedirs(cache_dir, mode=0o700, exist_ok=True)
    os.chmod(cache_dir, 0o700)

    # Single-instance lock, taken BEFORE touching the socket file. Two spawners
    # can start a daemon (launchd KeepAlive and the zh-voice CLI fallback), and
    # check-then-spawn is a TOCTOU race: without the lock, the loser would unlink
    # the live socket of the winner in cleanup() below and leave a 3.4 GB zombie
    # that serves nothing. With the lock, the loser exits here without touching
    # anything.
    global _lock_fd                     # keep the fd alive; close would drop the lock
    _lock_fd = open(SOCK_PATH + ".lock", "w")
    os.chmod(SOCK_PATH + ".lock", 0o600)
    try:
        fcntl.lockf(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("another instance holds the lock; exiting", flush=True)
        return 0

    cleanup()
    atexit.register(cleanup)
    # Ignore SIGHUP. A handler would cancel nohup, and the daemon would die when the shell that started it exits.
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: sys.exit(0))
    try:
        os.setsid()          # detach from the parent session: closing the terminal or ending the task no longer affects the daemon
    except OSError:
        pass

    # A pinned path that is set but unusable is a silent version drift: the daemon
    # still transcribes, but with other weights. Log it, so that it is not found
    # only through the rev= field in PONG.
    if MODEL_PATH and model_target() != MODEL_PATH:
        print(f"⚠️  ZH_VOICE_MODEL_PATH={MODEL_PATH} 里没有 config.json，"
              f"退回 repo id {MODEL}（版本由 refs/main 决定，没有钉住）", flush=True)

    global _worker, _loaded_from, _tokenizer_pinned
    _worker = ASRWorker()
    try:
        ready = _worker.start()
    except WorkerUnavailable as exc:
        print(f"模型 worker 起不来：{exc}", flush=True)
        return 70
    _loaded_from = ready["model"]
    _tokenizer_pinned = bool(ready["tokenizer_pinned"])
    if not _tokenizer_pinned:
        # Not fatal: when the pin is not possible, the install check requires the
        # upstream repo to exist with a tokenizer that is byte-identical to the
        # pinned one. Log it anyway, so that it is not silent.
        print("⚠️  词表没能钉到 snapshot，仍然来自上游 DEFAULT_MODEL_ID 那个仓库", flush=True)

    # Bind the socket only after the worker is READY. So "the socket exists"
    # means "the weights are in memory", and the install check and the clients
    # can rely on this order.
    old_umask = os.umask(0o077)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        srv.bind(SOCK_PATH)
    finally:
        os.umask(old_umask)
    os.chmod(SOCK_PATH, 0o600)
    srv.listen(4)
    global _server
    _server = srv
    # This listener never accesses the model pipe. Inference stays serialized
    # on the data listener; health reports busy until the worker's deadline.
    global _health_server
    _health_server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    _health_server.bind(SOCK_PATH + ".health")
    os.chmod(SOCK_PATH + ".health", 0o600)
    _health_server.listen(4)

    def health_loop():
        listener = _health_server
        while True:
            try:
                conn, _ = listener.accept()
            except OSError:
                return
            handle(conn, _worker, health_only=True)

    threading.Thread(target=health_loop, daemon=True).start()
    print(f"ready: {_loaded_from} tokenizer_pinned={_tokenizer_pinned}", flush=True)

    # ZH_VOICE_IDLE <= 0 means resident mode, which launchd uses. The model stays
    # in memory. The cost is ~3.4 GB resident. The gain is that the model never
    # cold-starts at the moment of a hotkey press, where recording and the 3.4 GB
    # cold load would compete for the same second.
    if IDLE_SEC > 0:
        threading.Thread(target=watchdog, daemon=True).start()
    else:
        print("resident: idle timeout disabled", flush=True)

    global last_used
    while True:
        conn, _ = srv.accept()
        last_used = time.time()
        restart = handle(conn, _worker)
        last_used = time.time()
        if restart:
            print("退出 70，让 launchd 换一个干净的 daemon", flush=True)
            return 70


if __name__ == "__main__":
    sys.exit(main())
