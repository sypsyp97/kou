#!/usr/bin/env bash
# Local Mandarin dictation: record from the default mic until interrupted (or until
# silence, in standalone use), transcribe, emit one line of Simplified Chinese on stdout.
#
# Usage:  zh-voice            # record, then transcribe
#         zh-voice clip.wav   # transcribe an existing file (no mic)
#         zh-voice --from-recorder clip.wav   # same, but the caller guarantees 16 kHz mono (see below)
#         zh-voice --health   # is the resident daemon actually serving?
#         zh-voice --doctor   # check each item: dependencies, model cache, daemon
#
# Env:  ZH_VOICE_MODEL   Qwen3-ASR model id (0.6B is ~2x faster, noticeably worse
#                        on English jargon: sbatch->batch, GR00T->GR零零G)
#       ZH_VOICE_ASR_REVISION / _MODEL_PATH  pin the HF snapshot to load (see
#                        find_model_arg below; a repo id alone does not pin a version)
#       ZH_VOICE_TERMS   term-bias file (default ~/.config/zh-voice/terms.txt)
#       ZH_VOICE_CONTEXT_PREFIX  prefix of the term list, default "Technical terms:".
#                        Only this and "Vocabulary:"/"Proper nouns:" worked in
#                        measurements (see the CONTEXT section below)
#       ZH_VOICE_MAX_SEC recording cap, default 60
#       ZH_VOICE_HANG    silence seconds that end a recording, default 2.0
#       ZH_VOICE_DAEMON_WAIT      socket reply deadline, default 195s (must be
#                        longer than the daemon HANG_CEIL; see DAEMON_WAIT below)
#       ZH_VOICE_VAD_ENABLED      set to 0 to bypass the local VAD, default 1
#       ZH_VOICE_VAD_THRESHOLD / _OFFSET  Silero start/stop thresholds, default 0.5 / 0.35
#       ZH_VOICE_VAD_MIN_SPEECH_MS  minimum speech span, default 250 ms
#       ZH_VOICE_CORPUS_FLAG / _DIR  local corpus archive: flag file (default
#                        ~/.config/zh-voice/corpus; archive only if it exists) and
#                        target directory (default ~/.local/share/zh-voice/corpus)
set -euo pipefail

# Everything at runtime is local; the models are provisioned at install time.
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
# GUI-launched processes inherit the minimal launchd PATH. A missing soxi or
# opencc degrades silently. Append the Homebrew paths instead of prepending
# them, so the caller (and the test suite's stub bin) still wins.
export PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}:/opt/homebrew/bin:$HOME/.local/bin"

MODEL="${ZH_VOICE_MODEL:-mlx-community/Qwen3-ASR-1.7B-8bit}"
MAX_SEC="${ZH_VOICE_MAX_SEC:-60}"
HANG="${ZH_VOICE_HANG:-2.0}"
TERMS_FILE="${ZH_VOICE_TERMS:-$HOME/.config/zh-voice/terms.txt}"
SOCK="${ZH_VOICE_SOCKET:-$HOME/.cache/zh-voice/asr.sock}"
# Must be LONGER than the daemon HANG_CEIL (180s in zh-voice-daemon). If the
# client gave up first, the daemon would still be decoding a long utterance
# while the client falls back to the one-shot CLI and loads a second 3.4 GB
# model. Two copies of the weights in memory is what the daemon CEIL comment
# prevents. If the daemon gives up first, that is the designed path: it
# replies ERROR, the client falls back at once, and launchd starts a clean
# daemon.
# Keep this size relation when you change this value or the daemon CEIL.
# test_daemon_wait_outlives_worker_ceiling checks it.
DAEMON_WAIT="${ZH_VOICE_DAEMON_WAIT:-195}"
# Pin the ASR snapshot, as for the VAD. `--model <repo id>` does NOT pin a
# version: in offline mode huggingface_hub reads refs/main, which is the most
# recently fetched snapshot in the cache. After an upstream update it differs
# from the pinned one, and the only symptom is worse transcription.
# The daemon uses ZH_VOICE_MODEL_PATH from its plist. This pin covers the CLI
# fallback path.
ASR_REVISION="${ZH_VOICE_ASR_REVISION:-a8379a2e2f9e313c9292cdf1af4055ab56d50d55}"
MODEL_SNAPSHOTS="${HF_HOME:-$HOME/.cache/huggingface}/hub/models--${MODEL//\//--}/snapshots"
VAD_MODEL="${ZH_VOICE_VAD_MODEL:-aufklarer/Silero-VAD-v6.2.1-CoreML}"
# Pinned Silero VAD snapshot revision.
VAD_REVISION="${ZH_VOICE_VAD_REVISION:-523876545a57961474fee9df913e833e130560b8}"
VAD_BIN="${ZH_VOICE_VAD_BIN:-zh-voice-audio}"
VAD_CACHE_ROOT="${HF_HOME:-$HOME/.cache/huggingface}/hub/models--${VAD_MODEL//\//--}/snapshots"

# Value for `mlx-qwen3-asr --model`. Prefer the pinned snapshot directory (the
# parameter is path_or_hf_repo and accepts a local path). Fall back to the repo
# id only if the snapshot is missing. The fallback is deliberate: an unpinned
# version is better than no transcription. --doctor reports version drift.
find_model_arg() {
  if [ -n "${ZH_VOICE_MODEL_PATH:-}" ] && [ -f "$ZH_VOICE_MODEL_PATH/config.json" ]; then
    printf '%s\n' "$ZH_VOICE_MODEL_PATH"
    return 0
  fi
  if [ -n "${ASR_REVISION:-}" ] && [ -f "$MODEL_SNAPSHOTS/$ASR_REVISION/config.json" ]; then
    printf '%s\n' "$MODEL_SNAPSHOTS/$ASR_REVISION"
    return 0
  fi
  printf '%s\n' "$MODEL"
}

# An explicit path wins (tests and debugging use it). Otherwise look in the HF
# cache for the compiled .mlmodelc directory. If nothing is found, return an
# empty string instead of an error: the caller then fails open.
find_vad_model() {
  if [ -n "${ZH_VOICE_VAD_MODEL_PATH:-}" ]; then
    [ -d "$ZH_VOICE_VAD_MODEL_PATH" ] && printf '%s\n' "$ZH_VOICE_VAD_MODEL_PATH"
    return 0
  fi
  [ -d "$VAD_CACHE_ROOT" ] || return 0
  # Prefer the pinned revision. With several versions in the cache,
  # `-print -quit` would pick one by directory order.
  if [ -n "${VAD_REVISION:-}" ] \
     && [ -d "$VAD_CACHE_ROOT/$VAD_REVISION/silero_vad.mlmodelc" ]; then
    printf '%s\n' "$VAD_CACHE_ROOT/$VAD_REVISION/silero_vad.mlmodelc"
    return 0
  fi
  # Fall back to any cached version: at run time a different version is better
  # than a stopped pipeline.
  find "$VAD_CACHE_ROOT" -mindepth 2 -maxdepth 2 -type d \
    -name silero_vad.mlmodelc -print -quit 2>/dev/null || true
}

# Health has its own listener so a valid long transcription cannot block PING.
# Fall back to the data socket only for compatibility with older daemons.
if [ "${1:-}" = "--health" ]; then
  [ ! -S "$SOCK.health" ] || SOCK="$SOCK.health"
  if [ ! -S "$SOCK" ]; then
    # Keep the braces: when $SOCK is followed by a full-width parenthesis, bash
    # counts the first byte of that multibyte character as part of the variable
    # name, and set -u fails with "SOCK\xef: unbound variable".
    echo "unhealthy: 没有 socket，daemon 没在跑（${SOCK}）" >&2
    exit 1
  fi
  PONG="$(printf 'PING\n\n' | nc -w "${ZH_VOICE_HEALTH_TIMEOUT:-10}" -U "$SOCK" 2>/dev/null | tail -1 || true)"
  # Match the prefix, not the whole reply. The reply is "PONG <model name>".
  # Echoing the model name shows which model the live daemon runs.
  case "$PONG" in
    PONG*)
      echo "healthy: ${PONG}"
      exit 0
      ;;
  esac
  echo "unhealthy: PING 没等到 PONG（收到 '${PONG}'），daemon 大概卡在转写里了" >&2
  exit 1
fi

# Health check: run this first when something fails. Dependencies have two
# tiers. A missing opencc only disables Traditional-to-Simplified conversion
# (the script degrades). A missing soxi, ffmpeg or nc breaks the whole pipeline.
if [ "${1:-}" = "--doctor" ]; then
  FAILED=0
  for CMD in soxi ffmpeg nc mlx-qwen3-asr "$VAD_BIN"; do
    if command -v "$CMD" >/dev/null 2>&1; then
      printf 'ok    %-14s %s\n' "$CMD" "$(command -v "$CMD")"
    else
      printf 'FAIL  %-14s 不在 PATH 上\n' "$CMD"
      FAILED=1
    fi
  done
  if command -v opencc >/dev/null 2>&1; then
    printf 'ok    %-14s %s\n' "opencc" "$(command -v opencc)"
  else
    printf 'warn  %-14s 不在 PATH 上（只影响繁简转换，不影响出字）\n' "opencc"
  fi

  # Check the PINNED snapshot, not "anything in the cache". The latter reports
  # ok when the pinned version was purged after an upstream update.
  if [ -f "$MODEL_SNAPSHOTS/$ASR_REVISION/config.json" ]; then
    printf 'ok    %-14s %s @ %s\n' "model" "$MODEL" "${ASR_REVISION:0:12}…"
  else
    printf 'FAIL  %-14s %s 缺少钉死的 snapshot %s（daemon 跑离线模式，下载不了）\n' \
      "model" "$MODEL" "${ASR_REVISION:0:12}…"
    FAILED=1
  fi

  # Tokenizer: the daemon pins it to the snapshot it loads (see pin_tokenizer_dir
  # in zh-voice-daemon). With the pin, the upstream DEFAULT_MODEL_ID repo is not
  # needed: transcription works even with an empty HF cache.
  # The pin requires that the snapshot contains the tokenizer files, so check
  # that first. Only if it does not, require the upstream cache, because then the
  # tokenizer comes from it. If that cache is missing, every transcription
  # replies ERROR while every other check stays green.
  # The tok= field in the daemon PONG line below shows whether the pin is active.
  MODEL_TOK_DIR="$MODEL_SNAPSHOTS/$ASR_REVISION"
  if [ -f "$MODEL_TOK_DIR/vocab.json" ] && [ -f "$MODEL_TOK_DIR/merges.txt" ] \
     && [ -f "$MODEL_TOK_DIR/tokenizer_config.json" ]; then
    printf 'ok    %-14s %s\n' "tokenizer" "钉在 $MODEL 自己的 snapshot 上"
  else
    TOKENIZER_MODEL="${ZH_VOICE_TOKENIZER_MODEL:-Qwen/Qwen3-ASR-0.6B}"
    TOKENIZER_SNAPSHOTS="${HF_HOME:-$HOME/.cache/huggingface}/hub/models--${TOKENIZER_MODEL//\//--}/snapshots"
    if [ -n "$(find "$TOKENIZER_SNAPSHOTS" -mindepth 2 -maxdepth 2 -name vocab.json -print -quit 2>/dev/null)" ]; then
      printf 'warn  %-14s 钉不住，回落到上游 %s（它的缓存不能删）\n' \
        "tokenizer" "$TOKENIZER_MODEL"
    else
      printf 'FAIL  %-14s 钉不住，而上游 %s 也没有缓存（每次转写都会回 ERROR）\n' \
        "tokenizer" "$TOKENIZER_MODEL"
      FAILED=1
    fi
  fi

  # A missing VAD does not stop dictation (fail-open), but it reopens the
  # term-list leak (see the voice gate below), so it counts as FAIL.
  if [ -n "$(find_vad_model)" ]; then
    printf 'ok    %-14s %s\n' "vad model" "$VAD_MODEL"
  else
    printf 'FAIL  %-14s %s 没有本地 Core ML 缓存\n' "vad model" "$VAD_MODEL"
    FAILED=1
  fi

  if HEALTH="$("$0" --health 2>/dev/null)"; then
    printf 'ok    %-14s %s\n' "daemon" "$HEALTH"
  else
    printf 'FAIL  %-14s 健康检查没通过（%s --health 看详情）\n' "daemon" "$0"
    FAILED=1
  fi
  exit "$FAILED"
fi

# ── Run metrics: numbers only, never content ───────────────────────────────
# "Not heard" has several different causes: the VAD gated it as silence, the
# ASR returned empty, the daemon was replaced and the CLI fallback ran, or a
# term-list echo was dropped. The UI shows all of them the same way. One line
# of numbers tells them apart.
# Do NOT log audio paths or transcript text.
METRICS="${ZH_VOICE_METRICS:-$HOME/.cache/zh-voice/metrics.log}"
METRICS_MAX=$((256 * 1024))
metric() {
  [ "${ZH_VOICE_METRICS_ENABLED:-1}" = "0" ] && return 0
  # mkdir spawns only if the directory is missing ([ -d ] is a builtin). This function runs every turn.
  [ -d "${METRICS%/*}" ] || mkdir -p "${METRICS%/*}" 2>/dev/null || return 0
  if [ -f "$METRICS" ]; then
    _sz="$(stat -f%z "$METRICS" 2>/dev/null || echo 0)"
    [ "$_sz" -gt "$METRICS_MAX" ] && : >"$METRICS"
  fi
  printf '%s %s\n' "$(date '+%m-%d %H:%M:%S')" "$*" >>"$METRICS" 2>/dev/null || true
  return 0
}

# Extract one field from the VAD JSON line. Fields are numbers or true/false in
# single-line output, so python is not needed. Allow spaces after the colon:
# Swift JSONEncoder output is compact, but other encoders are not (the test
# stub uses Python json.dumps, which adds spaces).
json_num() {
  [ -f "${2:-}" ] || return 0
  local _json _pattern
  _pattern=".*\"$1\":[[:space:]]*([-0-9.a-z]*)"
  while IFS= read -r _json || [ -n "$_json" ]; do
    if [[ $_json =~ $_pattern ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
  done <"$2"
  return 0
}

M_VAD_P=""; M_VAD_SPEECH=""; M_AUDIO_IN=""; M_AUDIO_OUT=""
M_STRONG=""; M_VAD_DEGRADED=0; M_PATH="none"; M_RETRY=0

# The hotkey path writes the wav with our own recorder: always 16 kHz, mono,
# 16-bit. The VAD below also reports the duration. So `--from-recorder` skips
# three soxi calls (-r/-c/-D, 6.4 ms each). The standalone entry (any wav from
# the user) has no such guarantee, so it still probes format and duration.
FROM_RECORDER=0
if [ "${1:-}" = "--from-recorder" ]; then FROM_RECORDER=1; shift; fi

WORK="$(mktemp -d -t zhvoice)"
trap 'rm -rf "$WORK"' EXIT

if [ $# -ge 1 ]; then
  if [ "$FROM_RECORDER" = 1 ]; then
    cp "$1" "$WORK/in.wav"
  elif [ "$(soxi -r "$1" 2>/dev/null)" = "16000" ] && [ "$(soxi -c "$1" 2>/dev/null)" = "1" ]; then
    cp "$1" "$WORK/in.wav"
  else
    ffmpeg -y -loglevel error -i "$1" -ar 16000 -ac 1 -c:a pcm_s16le "$WORK/in.wav"
  fi
else
  FROM_RECORDER=1                    # the recording below is also 16 kHz mono
  echo "🎙  请说话（停顿 ${HANG}s 自动结束，最长 ${MAX_SEC}s）…" >&2
  # The native recorder gives Apple voice processing (echo cancellation, AGC)
  # and writes 16 kHz mono 16-bit directly, so no resampling is needed.
  # `--auto-stop-silence` stops the recording after the silence hang time.
  "$VAD_BIN" record "$WORK/in.wav" \
      --max-seconds "$MAX_SEC" --auto-stop-silence "$HANG" 2>/dev/null || true
fi

if [ ! -s "$WORK/in.wav" ]; then
  echo "没有录到声音（文件是空的）。若是第一次运行，去 系统设置 → 隐私与安全性 → 麦克风 打开终端(Ghostty)的权限。" >&2
  exit 1
fi
# The minimum-duration check applies to the standalone entry only. The caller
# of the hotkey path already rejects recordings that are too short, so a second
# check here would cost one more soxi call.
if [ "$FROM_RECORDER" = 0 ]; then
  DUR="$(soxi -D "$WORK/in.wav" 2>/dev/null || echo 0)"
  if awk -v d="$DUR" 'BEGIN{exit !(d < 0.4)}'; then
    echo "没有录到声音（时长 ${DUR}s）。若是第一次运行，去 系统设置 → 隐私与安全性 → 麦克风 打开终端(Ghostty)的权限。" >&2
    exit 1
  fi
fi

# ── Voice gate ──────────────────────────────────────────────────────────────
# With no speech, an ASR given a term list can output the WHOLE term list as
# the transcript, and the caller pastes it into the active app. Measured with
# the production 506-character context: pure noise, fan hum and white noise
# all produced the full string "技术术语：具身智能, LIBERO, LIBERO-Pro, …".
# Without a context the output is "嗯。". The size checks (MIN_BYTES, DUR < 0.4)
# and the daemon empty-result retry do not stop this: the output is non-empty.
#
# The gate is here and not in the daemon because both the socket path and the
# CLI path must pass it, and CONTEXT is built below.
# When the VAD finds silence, exit 0 and print nothing. The caller treats
# "exit code 0, empty output, empty stderr" as "not heard" and pastes nothing.
#
# If the detector itself fails, fail open (transcribe as usual): at run time an
# extra transcription is better than losing real speech to a failed probe.
# --doctor reports a broken install.
#
# `--trim` also cuts leading and trailing silence. It rewrites in.wav in place
# (write a temporary file, then replace atomically). This saves time, and long
# pauses also cause ASR hallucination. Example: a 27.8 s recording (first 25 s
# silent) is trimmed to 1.6 s. The VAD scans the whole file in 0.11 s.
if [ "${ZH_VOICE_VAD_ENABLED:-1}" != "0" ]; then
  VAD_MODEL_PATH="$(find_vad_model)"
  if command -v "$VAD_BIN" >/dev/null 2>&1 && [ -n "$VAD_MODEL_PATH" ]; then
    VAD_ERR="$WORK/vad.err"
    VAD_JSON="$WORK/vad.json"
    VAD_TRIM_FLAG="--trim"
    [ "${ZH_VOICE_VAD_TRIM:-1}" = "0" ] && VAD_TRIM_FLAG=""
    if "$VAD_BIN" analyze --json $VAD_TRIM_FLAG "$WORK/in.wav" "$VAD_MODEL_PATH" \
         >"$VAD_JSON" 2>"$VAD_ERR"; then
      M_VAD_P="$(json_num max_probability "$VAD_JSON")"
      M_VAD_SPEECH="$(json_num speech_duration_ms "$VAD_JSON")"
      M_AUDIO_IN="$(json_num input_duration_ms "$VAD_JSON")"
      M_AUDIO_OUT="$(json_num output_duration_ms "$VAD_JSON")"
      M_STRONG="$(json_num used_strong_rule "$VAD_JSON")"
    else
      VAD_STATUS=$?
      if [ "$VAD_STATUS" -eq 3 ]; then
        M_VAD_P="$(json_num max_probability "$VAD_JSON")"
        M_AUDIO_IN="$(json_num input_duration_ms "$VAD_JSON")"
        metric "gated=1 vad_p=${M_VAD_P:-?} audio_ms=${M_AUDIO_IN:-?}"
        exit 0
      fi
      M_VAD_DEGRADED=1
      VAD_DETAIL="$(tr '\n' ' ' <"$VAD_ERR" | sed -E 's/[[:space:]]+$//')"
      echo "VAD 检查失败，继续本地转写${VAD_DETAIL:+：$VAD_DETAIL}" >&2
    fi
  else
    M_VAD_DEGRADED=1
    echo "VAD 不可用，继续本地转写；跑 zh-voice --doctor 看是哪一项" >&2
  fi
fi

# Domain terms keep English jargon (LIBERO, sbatch, mLSTM …) from being decoded as
# Chinese homophones (eval->Apple, sbatch->Spatch were the observed failures).
#
# The wording of the context changes the result. Measured: 184 transcriptions
# with the same model (mlx-community/Qwen3-ASR-1.7B-8bit):
#
#   format                        mean WER (4 clips)  recall  term leak
#   no context                          35.2%          57%     0/4
#   terms joined by spaces              33.8%          65%     1/4
#   Technical terms: a, b, c.           18.2%          79%     0/4
#
# On the hardest clip the difference is larger: space-joined 87.5%, worse than
# no context (78.1%), against 28.1% with the wrapped form. On hard audio the
# space-joined list hurts, and it leaks terms that nobody said.
#
# Do not change the prefix. In the same experiment eight other prefixes
# (Terms:, Keywords:, Glossary:, Context:, Technical:, Technical vocabulary:,
# Programming terms:, Software terms:) all fell back to the bare-list level.
# Only Technical terms:, Vocabulary: and Proper nouns: passed. Any other value
# of ZH_VOICE_CONTEXT_PREFIX effectively disables the feature.
#
# The separator is a comma and the list ends with a period, as measured.
#
# Splitting rule: one term per line. A term may contain spaces (Claude Code,
# flow matching). Text after # is a comment.
# Terms are de-duplicated: a repeated term only wastes tokens.
CONTEXT_PREFIX="${ZH_VOICE_CONTEXT_PREFIX:-Technical terms:}"
CONTEXT=""
TERMS=""; WANT=""

# Replace punctuation literally; byte-oriented character classes can split UTF-8.
# Shell operations avoid process startup for short text. Long glob substitutions
# scale poorly in the system Bash, so longer text keeps the native pipeline.
# $2 = ws: keep whitespace and treat it as a comma separator. The ASR can also
# recite the term list separated by spaces. If whitespace were deleted, the
# string would contain no commas and every comma-based criterion would miss.
normalize_echo() {
  if [ "${#1}" -gt 128 ]; then
    if [ "${2:-}" = ws ]; then
      printf '%s' "$1" | sed -e 's/，/,/g' -e 's/、/,/g' -e 's/：/:/g' \
        | tr -s '[:space:]' ',' | sed -E -e 's/,+/,/g' -e 's/,$//' -e 's/[.。]+$//' -e 's/^,|,$//g'
    else
      printf '%s' "$1" | sed -e 's/，/,/g' -e 's/、/,/g' -e 's/：/:/g' \
        | tr -d '[:space:]' | sed -E 's/[.。]+$//'
    fi
    return
  fi
  local _normalized
  _normalized="${1//，/,}"
  _normalized="${_normalized//、/,}"
  _normalized="${_normalized//：/:}"
  if [ "${2:-}" = ws ]; then
    _normalized="${_normalized//[[:space:]]/,}"
    while [[ $_normalized == *,,* ]]; do _normalized="${_normalized//,,/,}"; done
    _normalized="${_normalized%,}"
  else
    _normalized="${_normalized//[[:space:]]/}"
  fi
  while :; do
    case "$_normalized" in
      *.) _normalized="${_normalized%.}" ;;
      *。) _normalized="${_normalized%。}" ;;
      *) break ;;
    esac
  done
  if [ "${2:-}" = ws ]; then
    _normalized="${_normalized#,}"
    _normalized="${_normalized%,}"
  fi
  printf '%s' "$_normalized"
}

# The term string (the context sent to the ASR) and its normalized form (the
# reference for the echo checks below) change only with terms.txt. Recomputing
# them each turn costs one sed+awk and three spawns (~15 ms). Cache them. The
# first cache line holds the terms.txt mtime and size as the key.
# Do not use the cheaper `[ $cache -nt $terms ]` (builtin, no spawn): bash 3.2
# compares only whole seconds. If terms.txt is edited in the same second that
# the cache is written, the new terms would never load, and that failure is
# silent. One stat call (3 ms) avoids it.
TERMS_CACHE="${ZH_VOICE_TERMS_CACHE:-$HOME/.cache/zh-voice/terms.cache}"
TERMS_KEY=""
if [ -f "$TERMS_FILE" ]; then
  TERMS_KEY="$(stat -f '%m-%z' "$TERMS_FILE" 2>/dev/null || echo none)"
  if [ -f "$TERMS_CACHE" ]; then
    { IFS= read -r _key; IFS= read -r TERMS; IFS= read -r WANT; } <"$TERMS_CACHE" || true
    [ "${_key:-}" = "$TERMS_KEY" ] || { TERMS=""; WANT=""; }
  fi
fi
if [ -f "$TERMS_FILE" ] && [ -z "$TERMS" ]; then
  TERMS="$(sed 's/#.*//' "$TERMS_FILE" | awk '
    function emit(t) {
      gsub(/^[ \t]+|[ \t]+$/, "", t)
      if (t == "" || (t in seen)) return
      seen[t] = 1
      printf "%s%s", (n++ ? ", " : ""), t
    }
    { emit($0) }')"
  WANT="$(normalize_echo "$TERMS")"
  # A cache write failure must not affect this turn. Write a temporary file,
  # then mv. On failure, behave as if there is no cache (recompute next turn).
  if [ -n "$TERMS" ]; then
    [ -d "${TERMS_CACHE%/*}" ] || mkdir -p "${TERMS_CACHE%/*}" 2>/dev/null || true
    if printf '%s\n%s\n%s\n' "$TERMS_KEY" "$TERMS" "$WANT" >"$TERMS_CACHE.$$" 2>/dev/null; then
      mv -f "$TERMS_CACHE.$$" "$TERMS_CACHE" 2>/dev/null || rm -f "$TERMS_CACHE.$$"
    fi
  fi
fi
# If only comments and blank lines remain, TERMS is empty. Send nothing. An
# empty shell "Technical terms: ." gives the model a prior without content.
if [ -n "$TERMS" ]; then
  CONTEXT="$CONTEXT_PREFIX $TERMS."
fi

# Prefer the resident daemon (model already in RAM); fall back to the one-shot CLI
# and start the daemon in the background so the NEXT utterance is the fast path.
#
# The daemon reports the transcription time itself, in the first reply line
# `META asr_ms=<n>`. It covers the model only and costs nothing. Timing on the
# client side would need two perl calls (5 ms each; bash 3.2 has no
# EPOCHREALTIME) and would include nc and the socket. The CLI fallback has no
# such number and records `asr_ms=?`.
#
# Transcribe once. $1 = the context to use (empty string = no term bias, used
# by the echo retry). A function lets the retry for a suspected term-list echo
# reuse the same socket/CLI fallback chain.
#
# The result goes to the global TRANSCRIBE_OUT, NOT to stdout. `$(transcribe …)`
# would run in a subshell and the M_PATH assignment would be lost.
transcribe() {
  _ctx="$1"; _out=""; _ms=""
  if [ -S "$SOCK" ]; then
    # `|| true`: without a daemon reply, pipefail makes set -e kill the script
    # silently before the fallback runs.
    # `-w $DAEMON_WAIT`: if the daemon hangs (rare MLX stall), nc would wait
    # forever. The value must be longer than the daemon HANG_CEIL budget (180 s
    # cap). Otherwise the client gives up first and starts a second 3.4 GB model
    # while the daemon is still decoding.
    # A sentinel preserves the empty payload line through command substitution.
    _raw="$(printf '%s\n%s\n' "$WORK/in.wav" "$_ctx" | nc -w "$DAEMON_WAIT" -U "$SOCK" 2>/dev/null || true
      printf '\001')"
    _raw="${_raw%$'\001'}"
    _raw="${_raw%$'\n'}"
    # The reply is `META asr_ms=<n>\n<transcript>`. The daemon guarantees a
    # single-line transcript (it joins newlines). Parameter expansion takes the
    # last line and saves one tail call. A reply without META (old daemon, PING,
    # ERROR) is one line, and the behavior stays the same. The META check
    # requires a real newline after it. Otherwise a transcript that starts with
    # "META asr_ms=" would be taken as a header.
    _out="${_raw##*$'\n'}"
    case "$_raw" in
      "META asr_ms="*$'\n'*)
        _header="${_raw%%$'\n'*}"
        _ms="${_header#META asr_ms=}"
        case "$_ms" in
          ''|*[!0-9]*) _out=""; _ms="" ;;
          *)
            case "$_out" in
              ERROR:*) _out=""; _ms="" ;;
              *)
                M_PATH="daemon"
                TRANSCRIBE_OUT="$_out"
                TRANSCRIBE_MS="$_ms"
                return 0
                ;;
            esac
            ;;
        esac
        ;;
    esac
    if [ "${ZH_VOICE_MANAGED_DAEMON:-0}" = 1 ]; then _out=""; _ms=""; fi
    case "$_out" in ERROR:*) echo "$_out" >&2; _out=""; _ms="" ;; esac
    [ -n "$_out" ] && M_PATH="daemon"
  fi
  if [ -z "$_out" ]; then
    if [ "${ZH_VOICE_MANAGED_DAEMON:-0}" = 1 ]; then
      # The app retains the recording and retries after its owned server recovers.
      # A CLI fallback here would load a second model during that recovery.
      echo "ASR service unavailable; managed recovery required" >&2
      return 75
    fi
    if pgrep -f zh-voice-daemon >/dev/null 2>&1; then :; else
      rm -f "$SOCK"                                # stale socket of a dead daemon
      # Write the log to $TMPDIR. /tmp is shared by all users, and `>` truncates
      # (O_TRUNC), so any zh-voice run would wipe the log of the running daemon.
      # That log is the only record of why a daemon died.
      LOG_DIR="${TMPDIR:-/tmp}"
      (nohup "$HOME/.local/bin/zh-voice-daemon" >"${LOG_DIR%/}/zh-voice-daemon.log" 2>&1 &)
    fi
    _out="$(mlx-qwen3-asr "$WORK/in.wav" --language zh --stdout-only \
             --model "$(find_model_arg)" ${_ctx:+--context "$_ctx"} 2>/dev/null \
           | grep -v '^Fetching' | tail -1 || true)"
    [ -n "$_out" ] && M_PATH="cli"
  fi
  TRANSCRIBE_OUT="$_out"
  TRANSCRIBE_MS="$_ms"
}

transcribe "$CONTEXT"                              # SOCK is set before the --health section
RAW="$TRANSCRIBE_OUT"
M_ASR_MS="${TRANSCRIBE_MS:-?}"

if [ -z "$RAW" ]; then
  metric "empty=1 path=$M_PATH asr_ms=$M_ASR_MS audio_ms=${M_AUDIO_IN:-?} vad_p=${M_VAD_P:-?}"
  [ "$M_PATH" != "daemon" ] || exit 0
  echo "转写为空（音频里没有可识别的语音，或 ASR 两条路径都失败了）" >&2
  exit 1
fi

# ── Term-list echo: second net after the VAD ───────────────────────────────
# The gate above fails open (a broken detector or a missing model cache still
# transcribes), so the leak path is not fully closed. This layer costs nothing.
# It normalizes the transcript and the term list (delete whitespace, convert
# full-width punctuation to half-width, strip a leading label such as
# "技术术语：", strip the final period). If the transcript is a PREFIX of the
# term list, it is not human speech: the model recited the context and the
# max-token limit cut it.
# All four measured leak outputs match. "嗯。" and "啪啪啪。" do not match
# (length threshold, not a prefix).
# A match follows the silence contract: exit 0, no output, the UI shows
# "not heard".
# (normalize_echo and the reference string WANT are computed or read from the
# cache in the CONTEXT section above.)
#
# Criterion 2: the transcript is not a prefix but mostly consists of terms from
# the list. The model recites them in another order, or only a middle part. The
# conditions are tight on purpose: a missed echo is better than a dropped real
# utterance.
#   - at least 12 characters after normalization ("嗯。" never takes part)
#   - at least 3 comma-separated parts, and at least 3 of them are exact terms
#   - the matching parts make up at least 75% of the total characters
echo_coverage_hit() {
  _got="$1"; _want="$2"
  case "$_got" in *,*) : ;; *) return 1 ;; esac      # no comma: not a list
  _total=0; _hit=0; _parts=0; _hitparts=0
  _ifs_save="$IFS"; IFS=','
  for _p in $_got; do
    [ -z "$_p" ] && continue
    _parts=$((_parts + 1)); _total=$((_total + ${#_p}))
    case ",$_want," in
      *,"$_p",*) _hitparts=$((_hitparts + 1)); _hit=$((_hit + ${#_p})) ;;
    esac
  done
  IFS="$_ifs_save"
  [ "$_parts" -ge 3 ] && [ "$_hitparts" -ge 3 ] && [ "$_total" -gt 0 ] \
    && [ $(( _hit * 100 / _total )) -ge 75 ]
}

# Criterion 3: real speech followed by the whole term list (or the reverse).
# Criterion 1 (not a prefix) and criterion 2 (real speech dilutes coverage
# below 75%) miss this mixed output. Example: 10.8 s of speech produced 582
# characters at ~68% coverage, and the whole text was pasted.
# An echo is a contiguous block. Check only the consecutive term run at each
# end: at least 3 parts and at least 60 characters in total. A person who names
# three terms in a row ("LIBERO、RoboCasa、MIKASA") does not reach 60
# characters. The whole list has several hundred.
echo_edge_run_hit() {
  _got="$1"; _want="$2"
  case "$_got" in *,*) : ;; *) return 1 ;; esac
  _head_p=0; _head_c=0; _head_done=0
  _run_p=0; _run_c=0
  _ifs_save="$IFS"; IFS=','
  for _p in $_got; do
    [ -z "$_p" ] && continue
    case ",$_want," in
      *,"$_p",*)
        _run_p=$((_run_p + 1)); _run_c=$((_run_c + ${#_p}))
        if [ "$_head_done" = 0 ]; then _head_p=$_run_p; _head_c=$_run_c; fi
        ;;
      *)
        _head_done=1; _run_p=0; _run_c=0
        ;;
    esac
  done
  IFS="$_ifs_save"
  { [ "$_head_p" -ge 3 ] && [ "$_head_c" -ge 60 ]; } \
    || { [ "$_run_p" -ge 3 ] && [ "$_run_c" -ge 60 ]; }
}

# Criterion 4: the decoding falls into a loop. The same segment repeats end to
# end until the token limit. Measured with mlx-qwen3-asr 0.4.4 and the
# production context: a sentence ending "DeepStack，用的那个 AdaLN-Zero，
# cross-attention，flow，matching，" looped to 1091 characters. The three echo
# criteria do not match it (only half of the loop unit consists of terms, and
# it is not a contiguous edge block), so the whole text would be pasted.
# Condition: a unit of at least 4 characters repeats at least 3 times in a row,
# and the repeated part has at least 30 characters. Human repetition does not
# reach this ("只有两百个，只有两百个，只有两百个" has 18 characters; "对对对对"
# has a 1-character unit).
# Known false positive: a sentence of at least 10 characters said three times
# unchanged also matches (the retry matches too, so the whole sentence is dropped).
# Use perl, not sed/awk: the check needs a back-reference and a length in
# characters, not bytes (-CSA).
# The 30-character condition is in the regex (*FAIL backtracks). If checked
# after the match, /g would consume a short repeat and a longer unit at the
# same position would never be tried. `--` stops a transcript that starts with
# "-" from being read as a perl option.
echo_loop_hit() {
  perl -CSA -e '$_ = shift; exit(/((.{4,}?)\2{2,})(?(?{ length($1) < 30 })(*FAIL))/ ? 0 : 1)' -- "$1"
}

# Normalize and strip a leading label such as "技术术语:". The first
# transcription and the retry result MUST share this function. If only one of
# them stripped the label, the 5-character label would dilute the coverage of a
# pure echo below 75%, and the echo would pass as a clean result.
canon_reply() {
  _c="$(normalize_echo "$1" "${2:-}")"
  _label="${_c%%:*}"
  if [ "$_label" != "$_c" ] && [ "${#_label}" -le 25 ]; then _c="${_c#*:}"; fi
  printf '%s' "$_c"
}

# ${#RAW} is a pre-filter. GOT is RAW without punctuation and whitespace, so it
# is never longer. A RAW below 12 characters cannot pass the 12-character
# threshold below, and short sentences skip the three spawns of canon_reply.
# (If ${#} counts bytes in a multibyte locale, the filter only becomes looser
# and never skips a text that needs the check.)
# TERMS does not need to be non-empty: the loop check does not use the term
# list. With empty TERMS, WANT is empty and criteria 1 to 3 never match. After
# a loop match, the retry loops the same way and the text is dropped, not pasted.
if [ "${#RAW}" -ge 12 ]; then
  GOT="$(canon_reply "$RAW")"
  SUSPECT=0
  if [ "${#GOT}" -ge 12 ]; then
    # The quotes in ${WANT#"$GOT"} make the prefix removal literal, so term characters are not globs
    [ "${WANT#"$GOT"}" != "$WANT" ] && SUSPECT=1                 # criterion 1: prefix
    echo_coverage_hit "$GOT" "$WANT" && SUSPECT=1                # criterion 2: coverage
    echo_edge_run_hit "$GOT" "$WANT" && SUSPECT=1                # criterion 3: edge run
    # The whitespace-split reference string is used only here and is not cached
    # (the cache format stays the same). Only long sentences pay this spawn.
    # The whitespace mode feeds criterion 3 only, not criterion 2. Chinese parts
    # are short and English term parts are long, so a real sentence such as
    # "用 Claude Code 跑 speculative decoding" exceeds 75% coverage and would be
    # dropped after the retry.
    WANT_WS="$(normalize_echo "$TERMS" ws)"
    echo_edge_run_hit "$(canon_reply "$RAW" ws)" "$WANT_WS" && SUSPECT=1   # criterion 3, whitespace split
    echo_loop_hit "$GOT" && SUSPECT=1                            # criterion 4: loop
  fi
  if [ "$SUSPECT" = 1 ]; then
    # Do not drop at once. First transcribe again WITHOUT context. The gate fails
    # open, so real speech may exist and the term bias may have covered it. This
    # one retry happens only for a suspect result, so normal transcriptions do
    # not slow down.
    M_RETRY=1
    transcribe ""
    RAW2="$TRANSCRIBE_OUT"
    # Both runs need a server number to add them. If one is missing, record ? for the whole line, not a half sum.
    if [ "$M_ASR_MS" != "?" ] && [ -n "${TRANSCRIBE_MS:-}" ]; then
      M_ASR_MS=$((M_ASR_MS + TRANSCRIBE_MS))
    else
      M_ASR_MS="?"
    fi
    GOT2="$(canon_reply "$RAW2")"        # same normalization, label stripped too
    if [ -n "$RAW2" ] && [ "${#GOT2}" -ge 2 ] \
       && [ "${WANT#"$GOT2"}" = "$WANT" ] && ! echo_coverage_hit "$GOT2" "$WANT" \
       && ! echo_edge_run_hit "$GOT2" "$WANT" \
       && ! echo_edge_run_hit "$(canon_reply "$RAW2" ws)" "$WANT_WS" \
       && ! echo_loop_hit "$GOT2"; then
      RAW="$RAW2"                        # the clean version: use it
    else
      # Both runs are echoes: same contract as silence (exit 0, no output, the UI shows "not heard")
      metric "echo_dropped=1 retry=1 path=$M_PATH asr_ms=$M_ASR_MS audio_ms=${M_AUDIO_IN:-?} vad_p=${M_VAD_P:-?}"
      exit 0
    fi
  fi
fi

# Output occasionally drifts into Traditional characters; pin it to Simplified.
# opencc is a Homebrew binary that can vanish independently of this script
# (brew upgrade/cleanup); losing the conversion is cosmetic, losing the whole
# transcript to a missing binary is not. Preserve the original text in that case.
metric "ok=1 path=$M_PATH asr_ms=$M_ASR_MS audio_ms=${M_AUDIO_IN:-?} trimmed_ms=${M_AUDIO_OUT:-?} vad_p=${M_VAD_P:-?} speech_ms=${M_VAD_SPEECH:-?} strong=${M_STRONG:-?} retry=$M_RETRY vad_degraded=$M_VAD_DEGRADED chars=${#RAW}"
if command -v opencc >/dev/null 2>&1; then
  FINAL="$(printf '%s' "$RAW" | opencc -c t2s)"
else
  FINAL="$RAW"
fi
FINAL="${FINAL//$'\n'/ }"
FINAL="${FINAL#"${FINAL%%[![:space:]]*}"}"
FINAL="${FINAL%"${FINAL##*[![:space:]]}"}"

# ── Local corpus archive (opt-in: `touch ~/.config/zh-voice/corpus`) ────────
# Collect audio and transcript pairs for ASR post-training. They stay on this
# machine and are never uploaded. The archive holds the in.wav after VAD trim
# (what the model heard), the final output and the context sent to the model.
# The "no audio or text in metrics" rule above still holds on the default path:
# without the flag file, no byte is written.
# An archive failure must not swallow the output of this turn. Every step ends
# with `|| true`, and before the result is printed only a local cp runs.
CORPUS_FLAG="${ZH_VOICE_CORPUS_FLAG:-$HOME/.config/zh-voice/corpus}"
CORPUS_DIR="${ZH_VOICE_CORPUS_DIR:-$HOME/.local/share/zh-voice/corpus}"
if [ -e "$CORPUS_FLAG" ]; then
  _id="$(date '+%Y%m%d-%H%M%S')-$$"
  if { [ -d "$CORPUS_DIR" ] || mkdir -p "$CORPUS_DIR" 2>/dev/null; } \
      && cp "$WORK/in.wav" "$CORPUS_DIR/$_id.wav" 2>/dev/null; then
    printf '%s\n' "$FINAL" >"$CORPUS_DIR/$_id.txt" 2>/dev/null || true
    printf '%s\n' "$CONTEXT" >"$CORPUS_DIR/$_id.ctx" 2>/dev/null || true
    printf '%s\tretry=%s\tpath=%s\tmodel=%s\tasr_ms=%s\taudio_ms=%s\ttrimmed_ms=%s\n' \
      "$_id" "$M_RETRY" "$M_PATH" "$MODEL" "$M_ASR_MS" "${M_AUDIO_IN:-?}" "${M_AUDIO_OUT:-?}" \
      >>"$CORPUS_DIR/index.tsv" 2>/dev/null || true
  fi
fi

printf '%s\n' "$FINAL"
