#!/usr/bin/env python3
"""Stub `pgrep`: reports "running" only when STUB_PGREP_FOUND=1, so tests can
choose whether the script believes a daemon is already alive."""
import json
import os
import sys

argv = sys.argv[1:]
_log = os.environ.get("STUB_LOG_DIR")
if _log:
    with open(os.path.join(_log, "pgrep.log"), "a") as fh:
        fh.write(json.dumps(argv) + "\n")

if os.environ.get("STUB_PGREP_FOUND") == "1":
    print("424242")
    sys.exit(0)
sys.exit(1)
